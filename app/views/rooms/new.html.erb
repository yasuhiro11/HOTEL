<h1>施設登録</h1>

<% if @room.errors.any? %>
  <div class="error-messages">
    <h2><%= pluralize(@room.errors.count, "エラー") %>が発生しました:</h2>
    <ul>
      <% @room.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= simple_form_for @room do |f| %>
  <%= f.input :name, label: "施設名", placeholder: "例: プリンスホテル", input_html: { class: "form-control" } %>
  <%= f.input :description, label: "説明", placeholder: "施設の詳細情報を入力してください", input_html: { class: "form-control" } %>
  <%= f.input :price, label: "価格 (円)", placeholder: "例: 15000", input_html: { class: "form-control" } %>
  <%= f.input :address, label: "住所", placeholder: "例: 東京都渋谷区", input_html: { class: "form-control" } %>
  <%= f.input :image, label: "画像", as: :file, input_html: { onchange: "previewImage(event)", class: "form-control" } %>
  <img id="image-preview" src="#" alt="プレビュー画像" style="display: none; max-width: 100%; margin-top: 10px;">
  <%= f.button :submit, "登録する", class: "btn btn-primary" %>
<% end %>

<script>
  function previewImage(event) {
    const reader = new FileReader();
    reader.onload = function () {
      const preview = document.getElementById('image-preview');
      preview.src = reader.result;
      preview.style.display = 'block';
    };
    reader.readAsDataURL(event.target.files[0]);
  }
</script>
