<h1>予約の作成</h1>

<% if @facility %>
  <div class="facility-details">
    <h2>施設情報</h2>
    <p><strong>施設名:</strong> <%= @facility.name %></p>
    <p><strong>詳細:</strong> <%= @facility.description %></p>
    <p><strong>住所:</strong> <%= @facility.location %></p>
    <p><strong>料金:</strong> <%= number_to_currency(@facility.price, unit: "￥", precision: 0, delimiter: ",") %></p>
  </div>
<% else %>
  <p>施設情報が見つかりません。</p>
<% end %>

<%= form_with(model: @booking, url: bookings_path, method: :post, local: true) do |form| %>
  
  <!-- 確実に facility_id を送信 -->
  <%= form.hidden_field :facility_id, value: @facility&.id %>

  <div class="field">
    <%= form.label :start_date, "開始日" %>
    <%= form.date_field :start_date, required: true %>
  </div>

  <div class="field">
    <%= form.label :end_date, "終了日" %>
    <%= form.date_field :end_date, required: true %>
  </div>

  <div class="field">
    <%= form.label :number_of_people, "人数" %>
    <%= form.number_field :number_of_people, min: 1, value: 1, required: true %>
  </div>

  <div class="actions">
    <%= form.submit "予約する", class: "btn btn-primary" %>
  </div>

<% end %>