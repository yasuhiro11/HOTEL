<h1>登録済み一覧</h1>

<table>
  <thead>
    <tr>
      <th>画像</th>
      <th>施設名</th>
      <th>説明文</th>
      <th>場所</th>
      <th>価格</th>
      <th>編集</th>
    </tr>
  </thead>
  <tbody>
    <% @facilities.each do |facility| %>
      <tr>
        <td>
          <% if facility.image.attached? %>
            <%= image_tag facility.image.variant(resize_to_limit: [100, 100]).processed, alt: "施設画像", size: "100x100" %>
          <% else %>
            <%= image_tag asset_path('default_hotel_image.png'), alt: "デフォルト画像", size: "100x100" %>
          <% end %>
        </td>
        <td><%= facility.name %></td>
        <td><%= facility.description %></td>
        <td><%= facility.location %></td>
        <td><%= number_to_currency(facility.price, unit: "￥", precision: 0, delimiter: ",") %></td>
        <td>
          <%= link_to "施設の編集", edit_facility_path(facility), class: "edit-link" %><br>
          <%= link_to "施設の削除", facility_path(facility), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "delete-link" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>