<div class="container">
  <h2 class="form-title">新規登録</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { multipart: true, class: "registration-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-group">
      <%= f.label :username, "ユーザー名", class: "form-label" %>
      <%= f.text_field :username, class: "form-input", placeholder: "ユーザー名を入力" %>
    </div>

    <div class="form-group">
      <%= f.label :email, "メールアドレス", class: "form-label" %>
      <%= f.email_field :email, class: "form-input", placeholder: "メールアドレスを入力" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "パスワード", class: "form-label" %>
      <%= f.password_field :password, class: "form-input", placeholder: "パスワードを入力" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "確認用パスワード", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-input", placeholder: "確認用パスワードを入力" %>
    </div>

    <div class="actions">
      <%= f.submit "新しいアカウントを作成", class: "form-submit-button" %>
    </div>
  <% end %>

  <div class="login-link">
    <%= link_to "アカウントをお持ちの方はログイン", new_session_path(resource_name) %>
  </div>
</div>
