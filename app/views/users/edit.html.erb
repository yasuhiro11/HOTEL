<div class="settings-container">
  <h1>設定</h1>
  <div class="settings-tabs">
    <ul class="tab-menu">
      <!-- アカウントタブ -->
      <li class="<%= params[:section] == 'account' || params[:section].blank? ? 'active' : '' %>">
        <%= link_to 'アカウント', edit_user_path(@user, section: 'account') %>
      </li>
      <!-- プロフィールタブ -->
      <li class="<%= params[:section] == 'profile' ? 'active' : '' %>">
        <%= link_to 'プロフィール', edit_user_path(@user, section: 'profile') %>
      </li>
    </ul>
  </div>

  <div class="tab-content">
    <% if params[:section] == 'profile' %>
      <!-- プロフィール編集フォーム -->
      <h2>プロフィール</h2>
      <%= form_with(model: @user, url: user_path(@user), method: :patch, local: true) do |f| %>
        <div class="form-group">
          <%= f.label :name, "名前" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :bio, "自己紹介" %>
          <%= f.text_area :bio, class: "form-control", rows: 5 %>
        </div>
        <div class="form-group">
          <%= f.label :avatar, "アイコン画像" %>
          <%= f.file_field :avatar, class: "form-control" %>
        </div>
        <%= f.submit "保存する", class: "btn btn-primary" %>
      <% end %>
    <% else %>
      <!-- アカウント編集フォーム -->
      <h2>アカウント</h2>
      <%= form_with(model: @user, url: user_registration_path, method: :put, local: true) do |f| %>
        <div class="form-group">
          <%= f.label :email, "メールアドレス" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :current_password, "現在のパスワード" %>
          <%= f.password_field :current_password, required: true, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :password, "新しいパスワード" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>
        <%= f.submit "保存する", class: "btn btn-primary" %>
      <% end %>
    <% end %>
  </div>
</div>
