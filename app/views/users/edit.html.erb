<h1>アカウント編集</h1>
<%= simple_form_for(current_user, url: user_registration_path, method: :put) do |f| %>
  <%= f.input :email, label: "メールアドレス" %>
  <%= f.input :password, label: "新しいパスワード", hint: "変更しない場合は空欄でOK" %>
  <%= f.input :password_confirmation, label: "パスワード確認" %>
  <%= f.button :submit, "更新する" %>
<% end %>
